# Unity generated folders (rebuilt automatically when the project is opened)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE / solution files
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Crash reports / OS files
*.stackdump
*.stackdump.meta
sysinfo.txt
crashlytics-build.properties
.DS_Store
Thumbs.db

# ML-Agents runtime timer dumps
Assets/ML-Agents/
Assets/ML-Agents.meta

# ML-Agents: keep final models + TensorBoard logs, skip big intermediate checkpoints
Assets/Training/results/**/checkpoint.pt
Assets/Training/results/**/*-*.pt
Assets/Training/results/**/*.pt.meta
# keep only the final model of each run, not the in-between exports and timing logs
Assets/Training/results/*/Dodger/Dodger-*.onnx
Assets/Training/results/*/Dodger/Dodger-*.onnx.meta
Assets/Training/results/*/run_logs/
Assets/Training/results/*/run_logs.meta
